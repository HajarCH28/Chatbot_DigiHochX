# ==============================================================================
# DigiHochX Chatbot - Configuration de l'environnement (GWDG Academic Cloud)
# Copiez ce fichier en '.env' et complétez avec votre clé personnelle SAIA / GWDG.
# Ne commitez JAMAIS votre fichier '.env' dans Git !
# ==============================================================================

# URL de base de l'API SAIA / Academic Cloud
GWDG_API_BASE=https://chat-ai.academiccloud.de/v1

# Clé API SAIA (obtenue sur https://chat-ai.academiccloud.de avec votre compte Uni Hildesheim)
GWDG_API_KEY=

# Modèle hébergé sur GWDG Academic Cloud
# Options disponibles actuellement dans votre interface :
# - deepseek-v4-flash-1017 (Recommandé : version récente du 17.10 avec meilleur suivi des consignes)
# - deepseek-v4-flash-0731 (Version du 31.07)
# - mistral-large          (Modèle Mistral grande capacité)
GWDG_DEFAULT_MODEL=deepseek-v4-flash-1017

# Langue par défaut du système (de = Deutsch, en = English)
DEFAULT_LANGUAGE=de

# Mot de passe administrateur DigiHochX (RBAC)
# Protège les opérations de gestion documentaire (upload, indexation, configuration avancée)
DIGIHOCHX_ADMIN_PASSWORD=DigiHochX#Admin2026!

